{
  "expo": {
    "name": "Unclouded",
    "slug": "unclouded",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.unclouded.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "package": "com.unclouded.app"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "69ed3ffc-a03c-4469-bfac-9a6872fd1923"
      }
    },
    "owner": "asabry1"
  }
}
